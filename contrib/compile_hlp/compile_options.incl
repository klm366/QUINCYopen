##
## provides "compile options" used by the compile_quincy.sh
##
## required variables (to be declared by the compile script):
##    'compile_setup'
##    'compileOptionsInclFile'
##    'flagUpdateCompileSetup'
##    'compiler'
##    'binaryBuildDir'
##    'flagNetcdf'
##
## modifying the required variables:
##    'compiler'
##    'binaryBuildDir'
##    'flagNetcdf'
##
## current dir is the '${buildDir}'
##

echo ""
echo "  ## sourcing the contrib/compile_hlp/compile_options.incl"

#--- test if required variables are declared
if [[ ! -v compile_setup ]]; then
  echo "    the variable \${compile_setup} does not exist"
  echo "EXIT!"
  exit 1
fi
if [[ ! -v compileOptionsInclFile ]]; then
  echo "    the variable \${compileOptionsInclFile} does not exist"
  echo "EXIT!"
  exit 1
fi
if [[ ! -v flagUpdateCompileSetup ]]; then
  echo "    the variable \${flagUpdateCompileSetup} does not exist"
  echo "EXIT!"
  exit 1
fi
if [[ ! -v flagNetcdf ]]; then
  echo "    the variable \${flagNetcdf} does not exist"
  echo "EXIT!"
  exit 1
fi
if [[ ! -v compiler ]]; then
  echo "    the variable \${compiler} does not exist"
  echo "EXIT!"
  exit 1
fi

# update ----------------------------------------------------------------------------------------------------
if [[ ${flagUpdateCompileSetup} == "TRUE" ]]; then

## the 'compileOptionsInclFile' does exists
## get values for 'compiler' & 'binaryBuildDir' & 'flagNetcdf'
### 'compiler'
lineCompilerInfo=$(grep -n "C\_N\ \=" ${compileOptionsInclFile} | awk 'BEGIN { FS = ":" } ; {print $1}')
compiler=$(sed -n "$lineCompilerInfo"p ${compileOptionsInclFile} | awk '{print $3}')
### 'binaryBuildDir'
lineBinaryBuildDirInfo=$(grep -n "COMP\ \=" ${compileOptionsInclFile} | awk 'BEGIN { FS = ":" } ; {print $1}')
binaryBuildDir=$(sed -n "$lineBinaryBuildDirInfo"p ${compileOptionsInclFile} | awk '{print $3}')
binaryBuildDir=${binaryBuildDir}"/"
### 'flagNetcdf'
grep -i "netcdf" ${compileOptionsInclFile} >> /dev/null
exitCode=$?  # exit code is 'zero' is the string "netcdf" was found at least once
if [[ ${exitCode} -eq 0 ]]; then 
  flagNetcdf="TRUE"
else
  flagNetcdf="FALSE"
fi
echo "    update modified code using previously set compile options"

# select compile options ------------------------------------------------------------------------------------
elif [[ ${flagUpdateCompileSetup} == "FALSE" ]]; then

#--- declare variables
## declare main variables for selection of compile options
flagCompOptSelected="FALSE"  # if a valid "compile setup" has been selected
cppKeyQuincy="-D __QUINCY_STANDALONE__ "
cppKeyNetcdf="-D __QUINCY_WITH_NETCDF__ "
## declare main variables for compile options (adding already some values that are identical for all compile options)
### specific to compiler
compCOMP=""
compCN=""
compMK=""
### specific to compiler and compile options
compFC=""
compFO="-I \${MODDIR}"
### specific to output format 'ascii text' & 'netcdf4' (modified below)
compNetcdfRoot=""
compNetcdfLibPath=""
compFL="F_L = \${C_N}"

#--- select compile options
validSetup="FALSE"
## output file format: ascii text
### compiler: gfortran
if [[ ${flagCompOptSelected} == "FALSE" ]]; then
  if [[ ${compile_setup} == "g-debug" ]] || [[ ${compile_setup} == "gd" ]]; then
    validSetup="TRUE"
    compFC="F_C = \${C_N} -g -c -cpp -ffpe-trap=invalid,zero,overflow -fbacktrace -ffree-line-length-0 "${cppKeyQuincy}
    compFO="F_O = -Og -J \${MODDIR} "${compFO}
    compiler="gfortran"
    flagNetcdf="FALSE"
    flagCompOptSelected="TRUE"
    echo "    compile options: "${compiler}" debug, with netcdf4 output: "${flagNetcdf}
  fi
fi
if [[ ${flagCompOptSelected} == "FALSE" ]]; then
  if [[ ${compile_setup} == "g-debug-scrutinise" ]] || [[ ${compile_setup} == "gds" ]]; then
    validSetup="TRUE"
    compFC="F_C = \${C_N} -g -c -cpp -Wall -ffpe-trap=invalid,zero,overflow -fbacktrace -ffree-line-length-0 "${cppKeyQuincy}
    compFO="F_O = -O0 -J \${MODDIR} "${compFO}
    compiler="gfortran"
    flagNetcdf="FALSE"
    flagCompOptSelected="TRUE"
    echo "    compile options: "${compiler}" debug-scrutinise, with netcdf4 output: "${flagNetcdf}
  fi
fi
if [[ ${flagCompOptSelected} == "FALSE" ]]; then
  if [[ ${compile_setup} == "g-standard" ]] || [[ ${compile_setup} == "gs" ]]; then
    validSetup="TRUE"
    compFC="F_C = \${C_N} -c -cpp -ffree-line-length-0 "${cppKeyQuincy}
    compFO="F_O = -O2 -march=native -J \${MODDIR} "${compFO}
    compiler="gfortran"
    flagNetcdf="FALSE"
    flagCompOptSelected="TRUE"
    echo "    compile options: "${compiler}" standard, with netcdf4 output: "${flagNetcdf}
  fi
fi
if [[ ${flagCompOptSelected} == "FALSE" ]]; then
  if [[ ${compile_setup} == "g-perform" ]] || [[ ${compile_setup} == "gp" ]]; then
    validSetup="TRUE"
    compFC="F_C = \${C_N} -c -cpp -ffree-line-length-0 "${cppKeyQuincy}
    compFO="F_O = -O3 -march=native -ffast-math -J \${MODDIR} "${compFO}
    compiler="gfortran"
    flagNetcdf="FALSE"
    flagCompOptSelected="TRUE"
    echo "    compile options: "${compiler}" perform, with netcdf4 output: "${flagNetcdf}
  fi
fi
### compiler: ifort
if [[ ${flagCompOptSelected} == "FALSE" ]]; then
  if [[ ${compile_setup} == "i-debug" ]] || [[ ${compile_setup} == "id" ]]; then
    validSetup="TRUE"
    compFC="F_C = \${C_N} -c -g -cpp -traceback -fpe0 -check all -check bounds -check noarg_temp_created -fp-model strict -fp-speculation=off "${cppKeyQuincy}
    compFO="F_O = -O0 -module \${MODDIR} "${compFO}
    compiler="ifort"
    flagNetcdf="FALSE"
    flagCompOptSelected="TRUE"
    echo "    compile options: "${compiler}" debug, with netcdf4 output: "${flagNetcdf}
  fi
fi
if [[ ${flagCompOptSelected} == "FALSE" ]]; then
  if [[ ${compile_setup} == "i-standard" ]] || [[ ${compile_setup} == "is" ]]; then
    validSetup="TRUE"
    compFC="F_C = \${C_N} -c -cpp -fp-model strict -fp-speculation=off "${cppKeyQuincy}
    compFO="F_O = -O2 -xHost -module \${MODDIR} "${compFO}
    compiler="ifort"
    flagNetcdf="FALSE"
    flagCompOptSelected="TRUE"
    echo "    compile options: "${compiler}" standard, with netcdf4 output: "${flagNetcdf}
  fi
fi
if [[ ${flagCompOptSelected} == "FALSE" ]]; then
  if [[ ${compile_setup} == "i-perform" ]] || [[ ${compile_setup} == "ip" ]]; then
    validSetup="TRUE"
    compFC="F_C = \${C_N} -c -cpp -fp-model source -fp-speculation=off "${cppKeyQuincy}
    compFO="F_O = -O3 -qmkl -static -xHost -module \${MODDIR} "${compFO}
    compiler="ifort"
    flagNetcdf="FALSE"
    flagCompOptSelected="TRUE"
    echo "    compile options: "${compiler}" perform, with netcdf4 output: "${flagNetcdf}
  fi
fi
## output file format: netcdf4
### compiler: gfortran
if [[ ${flagCompOptSelected} == "FALSE" ]]; then
  if [[ ${compile_setup} == "g-debug-netcdf" ]] || [[ ${compile_setup} == "gdn" ]]; then
    validSetup="TRUE"
    compFC="F_C = \${C_N} -g -c -cpp -ffpe-trap=invalid,zero,overflow -fbacktrace -ffree-line-length-0 "${cppKeyQuincy}${cppKeyNetcdf}
    compFO="F_O = -Og -J \${MODDIR} "${compFO}" -I \${NETCDFFROOT}/include"
    compiler="gfortran"
    flagNetcdf="TRUE"
    flagCompOptSelected="TRUE"
    echo "    compile options: "${compiler}" debug, with netcdf4 output: "${flagNetcdf}
  fi
fi
if [[ ${flagCompOptSelected} == "FALSE" ]]; then
  if [[ ${compile_setup} == "g-debug-scrutinise-netcdf" ]] || [[ ${compile_setup} == "gdsn" ]]; then
    validSetup="TRUE"
    compFC="F_C = \${C_N} -g -c -cpp -Wall -ffpe-trap=invalid,zero,overflow -fbacktrace -ffree-line-length-0 "${cppKeyQuincy}${cppKeyNetcdf}
    compFO="F_O = -O0 -J \${MODDIR} "${compFO}" -I \${NETCDFFROOT}/include"
    compiler="gfortran"
    flagNetcdf="TRUE"
    flagCompOptSelected="TRUE"
    echo "    compile options: "${compiler}" debug-scrutinise, with netcdf4 output: "${flagNetcdf}
  fi
fi
if [[ ${flagCompOptSelected} == "FALSE" ]]; then
  if [[ ${compile_setup} == "g-standard-netcdf" ]] || [[ ${compile_setup} == "gsn" ]]; then
    validSetup="TRUE"
    compFC="F_C = \${C_N} -c -cpp -ffree-line-length-0 "${cppKeyQuincy}${cppKeyNetcdf}
    compFO="F_O = -O2 -march=native -J \${MODDIR} "${compFO}" -I \${NETCDFFROOT}/include"
    compiler="gfortran"
    flagNetcdf="TRUE"
    flagCompOptSelected="TRUE"
    echo "    compile options: "${compiler}" standard, with netcdf4 output: "${flagNetcdf}
  fi
fi
if [[ ${flagCompOptSelected} == "FALSE" ]]; then
  if [[ ${compile_setup} == "g-perform-netcdf" ]] || [[ ${compile_setup} == "gpn" ]]; then
    validSetup="TRUE"
    compFC="F_C = \${C_N} -c -cpp -ffree-line-length-0 "${cppKeyQuincy}${cppKeyNetcdf}
    compFO="F_O = -O3 -march=native -ffast-math -J \${MODDIR} "${compFO}" -I \${NETCDFFROOT}/include"
    compiler="gfortran"
    flagNetcdf="TRUE"
    flagCompOptSelected="TRUE"
    echo "    compile options: "${compiler}" perform, with netcdf4 output: "${flagNetcdf}
  fi
fi
### compiler: ifort
if [[ ${flagCompOptSelected} == "FALSE" ]]; then
  if [[ ${compile_setup} == "i-debug-netcdf" ]] || [[ ${compile_setup} == "idn" ]]; then
    validSetup="TRUE"
    compFC="F_C = \${C_N} -c -g -cpp -traceback -fpe0 -check all -check bounds -check noarg_temp_created -fp-model strict -fp-speculation=off "${cppKeyQuincy}${cppKeyNetcdf}
    compFO="F_O = -O0 -module \${MODDIR} "${compFO}" -I \${NETCDFFROOT}/include"
    compiler="ifort"
    flagNetcdf="TRUE"
    flagCompOptSelected="TRUE"
    echo "    compile options: "${compiler}" debug, with netcdf4 output: "${flagNetcdf}
  fi
fi
if [[ ${flagCompOptSelected} == "FALSE" ]]; then
  if [[ ${compile_setup} == "i-standard-netcdf" ]] || [[ ${compile_setup} == "isn" ]]; then
    validSetup="TRUE"
    compFC="F_C = \${C_N} -c -cpp -fp-model strict -fp-speculation=off "${cppKeyQuincy}${cppKeyNetcdf}
    compFO="F_O = -O2 -xHost -module \${MODDIR} "${compFO}" -I \${NETCDFFROOT}/include"
    compiler="ifort"
    flagNetcdf="TRUE"
    flagCompOptSelected="TRUE"
    echo "    compile options: "${compiler}" standard, with netcdf4 output: "${flagNetcdf}
  fi
fi
if [[ ${flagCompOptSelected} == "FALSE" ]]; then
  if [[ ${compile_setup} == "i-perform-netcdf" ]] || [[ ${compile_setup} == "ipn" ]]; then
    validSetup="TRUE"
    compFC="F_C = \${C_N} -c -cpp -fp-model source -fp-speculation=off "${cppKeyQuincy}${cppKeyNetcdf}
    compFO="F_O = -O3 -qmkl -static -xHost -module \${MODDIR} "${compFO}" -I \${NETCDFFROOT}/include"
    compiler="ifort"
    flagNetcdf="TRUE"
    flagCompOptSelected="TRUE"
    echo "    compile options: "${compiler}" perform, with netcdf4 output: "${flagNetcdf}
  fi
fi

#--- Assert valid option
if [[ ${validSetup} == "FALSE" ]]; then
  echo "    no valid compile setup: "${compile_setup}", please check for valid setups with '/compile_quincy.sh -h'"
  echo "EXIT!"
  exit 1
fi

#--- set compiler specific options
if [[ ${compiler} == "gfortran" ]]; then
  compCOMP="COMP = x86_64-gfortran"
  compCN="C_N = gfortran"
  compMK="M_K = make --no-print-directory"
  # needed for compile script
  binaryBuildDir="x86_64-gfortran/"
elif [[ ${compiler} == "ifort" ]]; then
  compCOMP="COMP = x86_64-intel"
  compCN="C_N = ifort"
  compMK="M_K = gmake --no-print-directory"
  # needed for compile script
  binaryBuildDir="x86_64-intel/"
else
  echo "    compiler is not set to [gfortran,ifort] but: "${compiler}
  echo "EXIT!"
  exit 1
fi

#--- set output-format specific options (the 'netcdf root path' is compiler specific)
if [[ ${flagNetcdf} == "TRUE" ]]; then
  # gfortran / ifort
  if [[ ${compiler} == "gfortran" ]]; then  
    compNetcdfRoot="NETCDFFROOT = /opt/ohpc/pub/libs/gnu12/openmpi4/netcdf-fortran/4.6.0"
  else
    compNetcdfRoot="NETCDFFROOT = /opt/ohpc/pub/libs/intel/openmpi4/netcdf-fortran/4.6.0"
  fi
  # all compilers
  compNetcdfLibPath="NETCDFFLIBPATH = \${NETCDFFROOT}/lib"
  compFL="F_L = \${C_N} -L \${NETCDFFLIBPATH} -lnetcdff -Wl,-rpath,\${NETCDFFLIBPATH}"
elif [[ ${flagNetcdf} == "FALSE" ]]; then
  compNetcdfRoot=""
  compNetcdfLibPath=""
  compFL="F_L = \${C_N}"
else
  echo "    flagNetcdf is not set to [TRUE,FALSE] but: "${flagNetcdf}
  echo "EXIT!"
  exit 1
fi

#--- write output file with compiler options
echo "##"                                    > ${compileOptionsInclFile}
echo "## compiler specific options"         >> ${compileOptionsInclFile}
echo "##"                                   >> ${compileOptionsInclFile}
echo ${compCOMP}                            >> ${compileOptionsInclFile}
echo ${compCN}                              >> ${compileOptionsInclFile}
echo ${compNetcdfRoot}                      >> ${compileOptionsInclFile}
echo ${compNetcdfLibPath}                   >> ${compileOptionsInclFile}
echo ${compMK}                              >> ${compileOptionsInclFile}
echo ${compFC}                              >> ${compileOptionsInclFile}
echo ${compFO}                              >> ${compileOptionsInclFile}
echo ${compFL}                              >> ${compileOptionsInclFile}
echo ""                                     >> ${compileOptionsInclFile}

fi # END select compile options

echo "  ## end of sourced code from contrib/compile_hlp/compile_options.incl"
echo ""
